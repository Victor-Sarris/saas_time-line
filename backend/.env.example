# Copie para .env e ajuste. NUNCA comite o .env de verdade.

DJANGO_SECRET_KEY=troque-por-uma-chave-secreta-bem-longa
DJANGO_DEBUG=True
# ".vercel.app" cobre o dominio gerado pela Vercel e os previews
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,.vercel.app
DJANGO_TIME_ZONE=America/Sao_Paulo
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
MAX_UPLOAD_SIZE_MB=25

# Banco de dados
# Vazio = SQLite aqui do lado (backend/db.sqlite3).
# Na hospedagem, cole a connection string do Neon (a POOLED, com "-pooler"):
#   postgresql://user:senha@ep-xxx-pooler.sa-east-1.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=
DATABASE_SSL_REQUIRE=False

# Em serverless (Vercel) isto TEM que ser 0 — cada instância seguraria
# uma conexão aberta e o banco esgota. Em servidor normal, deixe 600.
DJANGO_CONN_MAX_AGE=600

# ---- A parte importante :) --------------------------------------------
HER_NAME=Sabrina
HIS_NAME=Sarrís
# Data em que voces comecaram a namorar (YYYY-MM-DD). Deixe vazio ate o grande dia.
COUPLE_SINCE=

HERO_TITLE=A nossa história
HERO_SUBTITLE=Cada foto aqui é um pedacinho de tempo que eu escolheria viver de novo.

LETTER_TITLE=Uma última coisa...
LETTER_BODY=Essa linha do tempo não tem fim — ela só está esperando as próximas fotos. Obrigado por cada dia ao seu lado.

# Cole o link normal da playlist do Spotify (Compartilhar > Copiar link)
SPOTIFY_PLAYLIST_URL=https://open.spotify.com/playlist/7HEepVF5nH22gECGtPybEE?si=fd5552d3a95b40a4
